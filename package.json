{
  "name": "titan-browser-engine",
  "version": "1.0.0",
  "description": "Titan — a from-scratch browser engine: HTML5 parser, CSS3 cascade, Flex/Grid layout, JS interpreter, event loop, tabs, paint.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "dotnet run --project Titan.Desktop/Titan.Desktop.csproj",
    "dev:web": "npm run build && node proxy-server.mjs",
    "desktop": "dotnet run --project Titan.Desktop/Titan.Desktop.csproj",
    "proxy": "node proxy-server.mjs",
    "test": "npm run build && node --test tests/smoke.js",
    "test:dist": "npm run build && node --test tests/smoke.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
